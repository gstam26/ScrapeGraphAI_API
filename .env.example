# ---------------------------------------------------------------------------
# Example environment file. Copy to `.env` and fill in the values you need:
#
#     cp .env.example .env
#
# `.env` is gitignored; this file is committed, so it must NEVER contain a real
# key, token or internal hostname. Every value below is intentionally blank.
#
# Nothing here is required in general — you only need the keys for the backends
# you actually use. Anything left blank falls back to the default in config.py.
# Precedence is: config.py default < .env < input workbook config sheet.
# ---------------------------------------------------------------------------


# ===========================================================================
# EXTRACTION BACKEND — pick one, set its keys
# ===========================================================================

# Which extractor to use: "azure" (default) | "claude" | "llmapi" | "sgai".
EXTRACT_TOOL=

# --- EXTRACT_TOOL=azure (production default) ---
# API key for the Azure OpenAI deployment used by extraction and the summary layer.
AZURE_API_KEY=
# Base URL of your Azure OpenAI resource, e.g. https://<your-resource>.openai.azure.com/openai/v1
AZURE_ENDPOINT=
# Deployment (model) name on that resource; defaults to gpt-4.1-mini.
AZURE_DEPLOYMENT=

# --- EXTRACT_TOOL=claude (off-network alternative) ---
# Anthropic API key for the Claude extractor.
CLAUDE_API_KEY=
# Claude model id; defaults to claude-haiku-4-5-20251001.
CLAUDE_MODEL=

# --- EXTRACT_TOOL=llmapi (legacy Power Automate flow) ---
# Full URL of the LLMAPI flow endpoint. src/llmapi.py raises if this is unset.
LLM_API_URL=

# --- EXTRACT_TOOL=sgai / ACQUIRE_TOOL=sgai ---
# ScrapeGraphAI API key, used by both the SGAI extractor and the SGAI fetcher.
SGAI_API_KEY=


# ===========================================================================
# ACQUISITION (fetch) BACKEND
# ===========================================================================

# Firecrawl API key. Needed for ACQUIRE_TOOL=firecrawl. Not needed for the
# self-hosted playwright/httpx backends, which are the default.
FIRECRAWL_API_KEY=


# ===========================================================================
# EMBEDDINGS (filter routing, link scoring, grouping)
# ===========================================================================

# Ollama server hosting nomic-embed-text. The config.py default points at an
# internal host that only resolves on the corporate network/VPN — set this to
# your own Ollama (e.g. http://localhost:11434) when running elsewhere.
OLLAMA_HOST=


# ===========================================================================
# OPTIONAL MODE FLAGS — machine-local behaviour switches
# These exist as env vars so per-machine choices never live as uncommitted
# edits to config.py. All have working defaults; leave blank to use them.
# ===========================================================================

# "threshold" (default) | "passthrough" — passthrough routes every question to
# every page, for extraction evaluations over hand-picked, known-relevant URLs.
FILTER_MODE=

# "true" enables the LLM AI Summary sheet. Off by default.
SUMMARY_ENABLED=

# Crawl frontier discipline: "bfs" (default) | "best_first".
CRAWL_STRATEGY=

# Link-discovery scope: "host" (default, exact host) | "site" (registered
# domain, so a hub homepage's own subdomains stay crawlable).
CRAWL_SCOPE=

# "true" re-renders a statically fetched seed whose link discovery is starved
# (JS-injected nav menus). Default false.
CRAWL_RENDER_FOR_DISCOVERY=

# "true" drops infrastructure paths (cdn-cgi, wp-json, …) at link discovery.
# Default false.
CRAWL_BLOCK_INFRA_PATHS=

# "true" (default) makes single-answer Matrix cells lead with one best answer.
# Set "false" to reproduce the older multi-candidate renders.
MATRIX_SINGLE_BEST=


# ===========================================================================
# OPTIONAL — evaluation harness and local web UI
# ===========================================================================

# Cross-encoder used by src/eval/cross_encoder.py. Override with a local
# filesystem path when the HuggingFace cache is unavailable offline.
CROSS_ENCODER_MODEL=
# Minimum cross-encoder score for a match; defaults to 0.50.
CROSS_ENCODER_MIN=

# Port for the local pipeline web UI (webapp/server.py); defaults to 8000.
PIPELINE_UI_PORT=
